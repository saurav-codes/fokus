# Copy real values into the project's Environment editor in the ox dashboard.
# Never put real secrets in git or in ox.toml.

SECRET_KEY=
DEBUG=false
ALLOWED_HOSTS=focus.lazyplanner.app
CSRF_TRUSTED_ORIGINS=https://focus.lazyplanner.app

# SQLite database and logs on a persistent, writable path (see ox.toml writable_paths)
DATABASE_PATH=/srv/ox/focus-timer/data/db.sqlite3
LOG_DIR=/srv/ox/focus-timer/data/logs

# Referencing REDIS_URL makes ox auto-provision Redis on the host
REDIS_URL=redis://127.0.0.1:6379/0

# Optional overrides (sane production defaults are built in)
# SECURE_SSL_REDIRECT=True
# SECURE_HSTS_SECONDS=31536000
# SESSION_COOKIE_SECURE=True
# CSRF_COOKIE_SECURE=True
# LOG_LEVEL=INFO
